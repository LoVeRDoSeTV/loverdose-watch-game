# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/database

# Twitch OAuth / API
TWITCH_CLIENT_ID=your_client_id
TWITCH_CLIENT_SECRET=your_client_secret
TWITCH_CHANNEL=loverdosetv
TWITCH_BROADCASTER_ID=your_broadcaster_id

# Application
NODE_ENV=production
SESSION_SECRET=change_this_to_a_long_random_secret
BASE_URL=http://localhost:3000
PORT=3000


# Tracker Twitch
# Aucune nouvelle clé n'est nécessaire. Après déploiement, le diffuseur autorise
# le tracker depuis Mon compte. Le callback à enregistrer chez Twitch est :
# https://VOTRE-DOMAINE/auth/twitch/tracker/callback

# Stream Deck (secret long et aléatoire, envoyé dans le header X-Stream-Deck-Token)
STREAM_DECK_TOKEN=change_this_to_a_long_random_token

# Optionnel : origines supplémentaires autorisées, séparées par des virgules
ALLOWED_ORIGINS=
